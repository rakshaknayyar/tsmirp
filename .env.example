# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored, so your password never goes to GitHub.

# PostgreSQL 16 + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=put-your-postgres-password-here
POSTGRES_DB=tsmirp

# Secret key that signs login tokens (JWT). At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# Redis (needed from Phase 2; /health reports "unavailable" if it is not running)
REDIS_URL=redis://localhost:6379/0
